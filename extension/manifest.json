{
  "manifest_version": 3,
  "minimum_chrome_version": "103",
  "name": "CatGIFs Uploader",
  "version": "1.0.0",
  "description": "Upload images to CatGIFs from the browser context menu.",
  "icons": {
    "16": "icons/catgifs-16.png",
    "32": "icons/catgifs-32.png",
    "48": "icons/catgifs-48.png",
    "128": "icons/catgifs-128.png"
  },
  "permissions": [
    "alarms",
    "contextMenus",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CatGIFs Uploader",
    "default_icon": {
      "16": "icons/catgifs-16.png",
      "32": "icons/catgifs-32.png"
    },
    "default_popup": "popup.html"
  }
}
